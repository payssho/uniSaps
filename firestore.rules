rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Tout utilisateur connecté peut lire n'importe quel profil (pour la recherche)
      allow read: if isAuth();
      // Seul le propriétaire peut modifier son profil
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);

      // Sous-collection garments : visible uniquement par le propriétaire
      match /garments/{garmentId} {
        allow read, write: if isOwner(uid);
      }

      // Sous-collection outfits : visible uniquement par le propriétaire
      match /outfits/{outfitId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Posts ────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      // Tout utilisateur connecté peut lire les posts (feed explorer/amis)
      allow read: if isAuth();
      // Seul le créateur peut créer/modifier/supprimer son post
      allow create: if isAuth() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuth() && resource.data.user_id == request.auth.uid;
      allow delete: if isAuth() && resource.data.user_id == request.auth.uid;
    }

    // ── Friend Requests ──────────────────────────────────────────────────────
    match /friend_requests/{requestId} {
      // Lecture autorisée si je suis l'expéditeur OU le destinataire
      allow read: if isAuth() && (
        resource.data.from_uid == request.auth.uid ||
        resource.data.to_uid == request.auth.uid
      );
      // Lister (query) : autorisé pour tout utilisateur connecté
      // (le filtrage from_uid/to_uid est géré côté client)
      allow list: if isAuth();
      // Création : seul l'expéditeur peut créer une demande en son nom
      allow create: if isAuth() && request.resource.data.from_uid == request.auth.uid;
      // Mise à jour (accepter/rejeter) : expéditeur ou destinataire
      allow update: if isAuth() && (
        resource.data.from_uid == request.auth.uid ||
        resource.data.to_uid == request.auth.uid
      );
      // Suppression (annuler) : expéditeur uniquement
      allow delete: if isAuth() && resource.data.from_uid == request.auth.uid;
    }
  }
}
