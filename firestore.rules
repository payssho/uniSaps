rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Vérifie que seul le champ "friends" est modifié (pour l'acceptation d'ami)
    function onlyFriendsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']);
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Tout utilisateur connecté peut lire n'importe quel profil
      allow read: if isAuth();
      // Seul le propriétaire crée son profil
      allow create: if isOwner(uid);
      // Le propriétaire peut tout modifier ; n'importe quel user authentifié
      // peut modifier uniquement le champ "friends" (acceptation/suppression d'ami)
      allow update: if isOwner(uid) || (isAuth() && onlyFriendsChanged());
      allow delete: if isOwner(uid);

      // Sous-collection garments : visible uniquement par le propriétaire
      match /garments/{garmentId} {
        allow read, write: if isOwner(uid);
      }

      // Sous-collection outfits : visible uniquement par le propriétaire
      match /outfits/{outfitId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Posts ────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      // Tout utilisateur connecté peut lire les posts
      allow read: if isAuth();
      // Seul le créateur peut créer son post
      allow create: if isAuth() && request.resource.data.user_id == request.auth.uid;
      // Seul le créateur peut modifier / supprimer son post
      allow update: if isAuth() && resource.data.user_id == request.auth.uid;
      allow delete: if isAuth() && resource.data.user_id == request.auth.uid;
    }

    // ── Friend Requests ──────────────────────────────────────────────────────
    match /friend_requests/{requestId} {
      // Lecture d'un document unique : expéditeur ou destinataire
      allow get: if isAuth() && (
        resource.data.from_uid == request.auth.uid ||
        resource.data.to_uid == request.auth.uid
      );
      // Lister (query where from_uid/to_uid) : tout user authentifié
      // (le SDK Firestore filtre ensuite côté client)
      allow list: if isAuth();
      // Créer : l'expéditeur doit être le user connecté
      allow create: if isAuth() && request.resource.data.from_uid == request.auth.uid;
      // Mettre à jour (accepter/rejeter) : expéditeur ou destinataire
      allow update: if isAuth() && (
        resource.data.from_uid == request.auth.uid ||
        resource.data.to_uid == request.auth.uid
      );
      // Supprimer (annuler) : expéditeur uniquement
      allow delete: if isAuth() && resource.data.from_uid == request.auth.uid;
    }
  }
}
